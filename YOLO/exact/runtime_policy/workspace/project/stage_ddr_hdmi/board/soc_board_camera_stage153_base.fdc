## OV5640 connector 0, copied from audited vendor FDC.
# Provisional 80 MHz PCLK and 0..4 ns input delay envelope; sensor/PCB
# timing and measured PCLK still require physical verification.
create_clock -name camera_clk_0 -period 12.5 -waveform {0 6.25} [get_ports camera_clk_0]
set_clock_uncertainty 0.4 [get_clocks camera_clk_0]
set_input_delay -max 4.0 -clock camera_clk_0 [get_ports {camera_data_0[*] camera_href_0 camera_vsync_0}]
set_input_delay -min 0.0 -clock camera_clk_0 [get_ports {camera_data_0[*] camera_href_0 camera_vsync_0}]
set_output_delay -max 5.0 -clock sys_clk [get_ports {SCL_0 SDA_0 cam_rst_0}]
set_output_delay -min 0.0 -clock sys_clk [get_ports {SCL_0 SDA_0 cam_rst_0}]
# Bound the CDC synchronizers, Gray pointers and held pixel FIFO payload.
set_max_delay 10.666666667 -datapath_only -from [get_clocks camera_clk_0] -to [get_clocks ddrphy_sysclk]
