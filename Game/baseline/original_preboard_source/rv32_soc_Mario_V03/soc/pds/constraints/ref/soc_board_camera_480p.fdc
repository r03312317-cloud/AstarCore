# Integration fragment, not a complete production FDC. Expected top instance:
# soc_mini_hdmi_clock u_hdmi_clock (...). sys_clk is already 27 MHz in base FDC.
# Keep pixel/serial clocks related. Do not set asynchronous groups between them.
create_generated_clock -name hdmi_pixel_clk -source [get_ports sys_clk] [get_pins {u_hdmi_clock.u_pll/clkout0}] -master_clock [get_clocks sys_clk] -multiply_by 1 -divide_by 1
create_generated_clock -name hdmi_serial_clk -source [get_ports sys_clk] [get_pins {u_hdmi_clock.u_pll/clkout1}] -master_clock [get_clocks sys_clk] -multiply_by 5 -divide_by 1
set_clock_uncertainty 0.1 [get_clocks hdmi_pixel_clk]
set_clock_uncertainty 0.1 [get_clocks hdmi_serial_clk]
# The output forwarded clock is serialized 1111100000, not a fabric clkout wire.
# Verify its phase and serializer acquisition in the primitive-backed TX test.
# Do not invent a monitor output_delay or hide all TMDS pins with false_path.
# Actual external TMDS eye/jitter/skew and monitor acceptance remain board gates.

