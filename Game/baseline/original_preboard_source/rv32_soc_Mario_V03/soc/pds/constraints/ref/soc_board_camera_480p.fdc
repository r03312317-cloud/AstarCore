create_clock -name camera_clk_1 -period 10.0 -waveform {0 5.0} [get_ports camera_clk_1]
set_clock_uncertainty 0.4 [get_clocks camera_clk_1]
set_input_delay -max 4.0 -clock camera_clk_1 [get_ports {camera_data_1[*] camera_href_1 camera_vsync_1}]
set_input_delay -min 0.0 -clock camera_clk_1 [get_ports {camera_data_1[*] camera_href_1 camera_vsync_1}]
set_max_delay 10.666666667 -datapath_only -from [get_clocks camera_clk_1] -to [get_clocks ddrphy_sysclk]
set_min_delay 0.0 -from [get_clocks camera_clk_1] -to [get_clocks ddrphy_sysclk]
set_max_delay 10.666666667 -datapath_only -from [get_clocks ddrphy_sysclk] -to [get_clocks camera_clk_1]
set_min_delay 0.0 -from [get_clocks ddrphy_sysclk] -to [get_clocks camera_clk_1]
set_output_delay -max 5.0 -clock sys_clk [get_ports {cam_rst_1}]
# SCCB pins do not feed a 27MHz sys_clk receiver. Boot SCCB uses a 4us bit
# interval (quarter bit = 1us); the CPU waits >=10us after each GPIO write.
# Use a separate protocol reference and a 500ns register-to-pad bound for
# BOTH drivers. This is stronger than the previous explicit 1us pad bound,
# and prevents the unrelated UI->sys synchronizer budget from also applying
# to these external pins. Internal CDC bounds above are unchanged.
# This digital budget does not certify pull-up rise time or physical wiring.
create_clock -name sccb_protocol_budget -period 2000.0 -waveform {0 1000.0}
set_output_delay -max 0.0 -clock sccb_protocol_budget [get_ports {SCL_0 SDA_0 SCL_1 SDA_1}]
set_output_delay -min 0.0 -clock sccb_protocol_budget [get_ports {SCL_0 SDA_0 SCL_1 SDA_1}]
set_max_delay 500.0 -datapath_only -from [get_clocks ddrphy_sysclk] -to [get_ports {SCL_0 SDA_0 SCL_1 SDA_1}]
set_max_delay 500.0 -datapath_only -from [get_clocks sys_clk] -to [get_ports {SCL_0 SDA_0 SCL_1 SDA_1}]
set_input_delay -max 5.0 -clock ddrphy_sysclk [get_ports {SCL_0 SDA_0 SCL_1 SDA_1}]
set_output_delay -min 0.0 -clock sys_clk [get_ports {cam_rst_1}]
set_min_delay 0.0 -from [get_clocks ddrphy_sysclk] -to [get_ports {SCL_0 SDA_0 SCL_1 SDA_1}]
set_min_delay 0.0 -from [get_clocks sys_clk] -to [get_ports {SCL_0 SDA_0 SCL_1 SDA_1}]
set_input_delay -min 0.0 -clock ddrphy_sysclk [get_ports {SCL_0 SDA_0 SCL_1 SDA_1}]

# CMOS2 input delay assumptions require subsequent physical validation.

