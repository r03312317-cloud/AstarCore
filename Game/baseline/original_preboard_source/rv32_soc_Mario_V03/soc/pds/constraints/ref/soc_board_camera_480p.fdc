# Generated from make_board_constraints.py; see board_constraints_inputs.json.
# CPU and NPU use separate 125 MHz-referenced GPLLs; board control uses 27 MHz.
create_clock -name sys_clk -period 37.037037037 -waveform {0 18.518518519} [get_ports sys_clk]
set_clock_uncertainty 0.1 [get_clocks sys_clk]
create_clock -name {ref_clk} [get_ports {clk_p}] -period {8.0} -waveform {0 4.0}
create_generated_clock -name cpu_clk_fast -source [get_ports {clk_p}] [get_pins {u_cpu_pll/clkout1}] -master_clock [get_clocks {ref_clk}] -multiply_by 14 -divide_by 25
set_clock_uncertainty 0.1 [get_clocks cpu_clk_fast]
create_generated_clock -name npu_clk_fast -source [get_ports {clk_p}] [get_pins {u_npu_pll/clkout1}] -master_clock [get_clocks {ref_clk}] -multiply_by 4 -divide_by 5
set_clock_uncertainty 0.1 [get_clocks npu_clk_fast]
create_generated_clock -name {rst_clk} -source [get_ports {clk_p}] [get_pins {I_ips_ddr_top.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {12} -divide_by {12}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {clk_p}] [get_pins {I_ips_ddr_top.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {12} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {clk_p}] [get_pins {I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {12} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {clk_p}] [get_pins {I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {12} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_groups -name ref_clk -asynchronous -group [get_clocks {ref_clk}]
set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]
define_attribute {i:I_ips_ddr_top.u_ddrphy_top.u_ddrphy_cpd} {PAP_LOC} {DDRPHY_CPD_729_772}
define_attribute {i:I_ips_ddr_top.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[0]} {PAP_LOC} {CLMA_717_672:FF3}
define_attribute {i:I_ips_ddr_top.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[1]} {PAP_LOC} {CLMA_717_978:FF3}
# Board 27 MHz control to HMIC user domain. These are synchronizer paths;
# constrain routing without hiding CDC or altering the functional clocks.
set_max_delay 10.666666667 -datapath_only -from [get_clocks sys_clk] -to [get_clocks ddrphy_sysclk]
set_min_delay 0.0 -from [get_clocks sys_clk] -to [get_clocks ddrphy_sysclk]
set_max_delay 10.666666667 -datapath_only -from [get_clocks ddrphy_sysclk] -to [get_clocks sys_clk]
set_min_delay 0.0 -from [get_clocks ddrphy_sysclk] -to [get_clocks sys_clk]
# NPU 100 MHz CDC FIFOs and level synchronizers to DDR and CPU70.
# Keep the inherited 5.128 ns routing budget for this functional build.
set_max_delay 5.128205128 -datapath_only -from [get_clocks npu_clk_fast] -to [get_clocks ddrphy_sysclk]
set_min_delay 0.0 -from [get_clocks npu_clk_fast] -to [get_clocks ddrphy_sysclk]
set_max_delay 5.128205128 -datapath_only -from [get_clocks ddrphy_sysclk] -to [get_clocks npu_clk_fast]
set_min_delay 0.0 -from [get_clocks ddrphy_sysclk] -to [get_clocks npu_clk_fast]
set_max_delay 5.128205128 -datapath_only -from [get_clocks npu_clk_fast] -to [get_clocks cpu_clk_fast]
set_min_delay 0.0 -from [get_clocks npu_clk_fast] -to [get_clocks cpu_clk_fast]
set_max_delay 5.128205128 -datapath_only -from [get_clocks cpu_clk_fast] -to [get_clocks npu_clk_fast]
set_min_delay 0.0 -from [get_clocks cpu_clk_fast] -to [get_clocks npu_clk_fast]
# CPU70<->DDR and CPU70<->27 MHz synchronizers/FIFOs.
# Preserve inherited 6.667 ns routing budget; it is not the 14.286 ns CPU period.
set_max_delay 6.666666667 -datapath_only -from [get_clocks cpu_clk_fast] -to [get_clocks ddrphy_sysclk]
set_min_delay 0.0 -from [get_clocks cpu_clk_fast] -to [get_clocks ddrphy_sysclk]
set_max_delay 6.666666667 -datapath_only -from [get_clocks ddrphy_sysclk] -to [get_clocks cpu_clk_fast]
set_min_delay 0.0 -from [get_clocks ddrphy_sysclk] -to [get_clocks cpu_clk_fast]
set_max_delay 6.666666667 -datapath_only -from [get_clocks cpu_clk_fast] -to [get_clocks sys_clk]
set_min_delay 0.0 -from [get_clocks cpu_clk_fast] -to [get_clocks sys_clk]
set_max_delay 6.666666667 -datapath_only -from [get_clocks sys_clk] -to [get_clocks cpu_clk_fast]
set_min_delay 0.0 -from [get_clocks sys_clk] -to [get_clocks cpu_clk_fast]
# External reset is asynchronous; each SoC clock domain synchronizes release.
set_false_path -from [get_ports rst_in]
# Asynchronous UART receive enters the UART synchronizer.
set_false_path -from [get_ports uart_rx]
# Board status/UART outputs have a loose 5 ns routing budget.
# UART TX is asynchronous to the PC receiver; bound fabric-to-pin latency.
set_max_delay 10.0 -datapath_only -from [get_clocks cpu_clk_fast] -to [get_ports uart_tx]
set_min_delay 0.0 -from [get_clocks cpu_clk_fast] -to [get_ports uart_tx]
set_output_delay -max 5.0 -clock sys_clk [get_ports {led[*]}]
set_output_delay -min 0.0 -clock sys_clk [get_ports {led[*]}]
# Physical pins: only the 85 bits on soc_board_top.
