# 27 MHz CPU and pixel domains use explicit handshake crossings; the original 13.468 ns bound is retained.
set_max_delay 13.468013468 -datapath_only -from [get_clocks sys_clk] -to [get_clocks hdmi_pixel_clk]
set_min_delay 0.0 -from [get_clocks sys_clk] -to [get_clocks hdmi_pixel_clk]
set_max_delay 13.468013468 -datapath_only -from [get_clocks hdmi_pixel_clk] -to [get_clocks sys_clk]
set_min_delay 0.0 -from [get_clocks hdmi_pixel_clk] -to [get_clocks sys_clk]
# DDR/pixel async FIFO Gray pointers: bound routing to the faster period.
set_max_delay 10.666666667 -datapath_only -from [get_clocks ddrphy_sysclk] -to [get_clocks hdmi_pixel_clk]
set_min_delay 0.0 -from [get_clocks ddrphy_sysclk] -to [get_clocks hdmi_pixel_clk]
set_max_delay 10.666666667 -datapath_only -from [get_clocks hdmi_pixel_clk] -to [get_clocks ddrphy_sysclk]
set_min_delay 0.0 -from [get_clocks hdmi_pixel_clk] -to [get_clocks ddrphy_sysclk]
# External DDR/TMDS analog timing and board behavior remain to be verified.

